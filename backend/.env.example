# Copy this file to .env and fill in the values. Never commit .env.

# Address the API listens on
PORT=3000
HOST=localhost
HOST_URL=http://localhost:3000

# SQL Server login (SQL Server Authentication, not a Windows account)
SQL_SERVER=localhost
SQL_DATABASE=WatchEat
SQL_USER=watcheat
SQL_PASSWORD=change-me
ENCRYPT=false

# Secret used to sign login tokens. Use a long random value, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_TOKEN=change-me

# Optional. Address of the frontend that may call the API from a browser
CORS_ORIGIN=http://localhost:4200

# Optional. Login and registration attempts allowed per address every 15 minutes
AUTH_RATE_LIMIT=20
